# ---------------------------------------------------------------------------
# ReconPay AI — environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public application URL (no trailing slash). Used for CSRF origin checks,
# vendor links, PayPal return URLs and password-reset links.
APP_URL=http://localhost:3000
NODE_ENV=development

# 32+ byte random secret used to sign sessions-adjacent tokens and file URLs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret
# Optional separate key for encrypting integration metadata.
APP_ENCRYPTION_KEY=replace-with-another-long-random-secret

# Conversation/hackathon convenience: shows demo credentials and seeds nothing
# automatically. Set to true for the public demo deployment only.
DEMO_MODE=true

# Production demo seeding guard. `npm run db:seed` refuses to run with
# NODE_ENV=production unless this is explicitly true. Never enable it for a
# deployment that contains real vendor or payment data.
# ALLOW_DEMO_SEED=false

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL blank to use the embedded PostgreSQL-compatible PGlite
# database at .data/reconpay (zero setup, real SQL). For Supabase/Render,
# set a PostgreSQL connection string and run the migrations.
#
# Supabase app connection: use the transaction pooler URL (port 6543) with
# sslmode=require. Remove any `?pgbouncer=true` parameter; postgres-js does not
# need it and may pass it to PostgreSQL as an unknown startup parameter.
# DATABASE_URL=postgresql://postgres.<project>:password@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Migrations need DDL, so use the direct connection or session pooler (port
# 5432) here. If omitted, migrations use DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://postgres.<project>:password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Set RUN_MIGRATIONS=true for the first deploy (and after adding a migration).
# It is safe to leave enabled; Drizzle records already-applied migrations.
# RUN_MIGRATIONS=false
# Set to true only if you have provisioned a restricted app role and enabled
# the optional RLS policy file (see docs/SECURITY.md and docs/supabase-rls.sql).
# ENABLE_RLS=false

# --- Document storage ------------------------------------------------------
# Local private storage is the default. On Render without a disk it is
# ephemeral, so configure the private Supabase Storage bucket for deployment.
# Keep the bucket private; the service-role key must stay server-side.
STORAGE_DIR=.data/storage
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
# SUPABASE_STORAGE_BUCKET=reconpay-evidence

# --- AI --------------------------------------------------------------------
# Without a key the app uses a deterministic PDF text extractor and
# rules-based explanations, clearly labelled in the UI. No fake AI results.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_MS=30000

# --- PayPal Sandbox --------------------------------------------------------
# Real REST integration. Payments stay disabled until credentials are present.
# INR is not a PayPal-supported currency; the UI blocks unsupported payments.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# --- Email (password reset, invitations) -----------------------------------
# Without an email provider, reset links are printed to the server console in
# development only. In production, configure a provider.
# RESEND_API_KEY=
# EMAIL_FROM=ReconPay AI <no-reply@example.com>

# --- Monitoring ------------------------------------------------------------
# SENTRY_DSN=
